{
    "name": "aboutcoders/job-bundle",
    "type": "symfony-bundle",
    "description": "A symfony bundle for asynchronous job processing.",
    "keywords": ["job", "jobs", "schedule", "scheduler", "cron", "cronjob", "bundle", "queue", "task", "background", "rest", "rest-api" , "asynchronous"],
    "homepage": "http://aboutcoders.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Hannes Schulz",
            "email": "hannes.schulz@aboutcoders.com"
        }
    ],
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/michalploneczka/scheduler-bundle.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "myclabs/php-enum": "^1.5",
        "gedmo/doctrine-extensions": "^3.0",
        "jms/serializer-bundle": "*",
        "nelmio/api-doc-bundle": "^3.0 || ^4.0",
        "doctrine/annotations": "1.*",
        "aboutcoders/process-control": "dev-master",
        "aboutcoders/scheduler-bundle": "dev-master",
        "aboutcoders/resource-lock-bundle": "dev-master || dev-php-8-2"
    },
    "require-dev": {
        "phpunit/phpunit": "~5.0|~6.0",
        "php-mock/php-mock-phpunit": "dev-master",
        "mikey179/vfsStream": "^1.5",
        "doctrine/orm": "~2.2,>=2.2.3",
        "doctrine/doctrine-bundle": "~1.2",
        "symfony/monolog-bundle": "~2",
        "symfony/swiftmailer-bundle": "~2.3",
        "sonata-project/notification-bundle": "~2.2",
        "zendframework/zendxml": "~1",
        "bernard/bernard-bundle" : "dev-master",
        "aboutcoders/process-control-bundle": "~1.3@dev"
    },
    "suggest": {
        "aboutcoders/process-control-bundle": "Adds process control, requires ^1.3",
        "aboutcoders/supervisor-bundle": "Manage supervisor processes, requires dev-master"
    },
    "autoload": {
        "psr-4": { "Abc\\Bundle\\JobBundle\\": "" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
